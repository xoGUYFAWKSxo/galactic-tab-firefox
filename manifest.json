{
  "manifest_version": 3,
  "name": "Galactic Tab",
  "version": "1.6.0",
  "description": "A rotating galaxy, nebula, black hole or ringed planet over gentle star flight, with themes, shortcuts, to-dos and search.",
  "permissions": [
    "search",
    "topSites",
    "theme",
    "storage"
  ],
  "icons": {
    "128": "assets/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "spiral-galaxy-new-tab@galactic-studio.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": [
      "strip-shared.js",
      "background.js"
    ]
  }
}
